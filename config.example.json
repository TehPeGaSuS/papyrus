{
  "_comment": "Papyrus configuration. Optional: Papyrus uses config.json when it exists (python3 app.py creates one with a random secret_key) and these defaults otherwise. Set the admin password with `python3 app.py admin`. Restart after changing values.",

  "site": {
    "name": "Papyrus",
    "tagline": "Simple, fast pastes with Markdown discussions.",
    "notice": "",
    "footer": "This website does not claim ownership of, copyright on, and assumes no liability for provided content.",
    "base_url": ""
  },

  "server": {
    "host": "127.0.0.1",
    "port": 5500,
    "debug": false,
    "secret_key": "change-this-to-a-long-random-secret"
  },

  "database": {
    "path": "papyrus.db"
  },

  "pastes": {
    "max_size_bytes": 2097152,
    "id_length": 12,
    "max_files": 10,
    "store_ips": false,
    "recent_limit": 50,
    "default_language": "text",
    "default_expiry": "1week",
    "expiries": {
      "1hour": 3600,
      "1day": 86400,
      "1week": 604800,
      "1month": 2592000
    }
  },

  "theme": {
    "default": "auto",
    "allow_user_toggle": true,
    "palette": "rust",
    "palettes": {
      "rust": {
        "label": "Rust",
        "logo_filter": "none",
        "light": {
          "primary": "#c2410c",
          "primary_hover": "#9a3412",
          "on_primary": "#ffffff",
          "background": "#ffffff",
          "surface": "#f6f6f7",
          "border": "#e4e4e7",
          "text": "#18181b",
          "text_secondary": "#52525b",
          "text_muted": "#a1a1aa",
          "danger": "#b91c1c"
        },
        "dark": {
          "primary": "#fb923c",
          "primary_hover": "#f97316",
